[{"id":29,"title":"测试","original_title":null,"type":"tv","cover_path":null,"cover_thumb_path":null,"description":null,"release_status":"ongoing","total_units":null,"total_subunits":null,"unit_label":null,"creators":{},"created_at":"2026-05-10T10:39:32.897354","updated_at":"2026-05-10T10:39:32.897358","tags":[],"collections":[],"main_watching":{"id":29,"work_id":29,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-10T10:39:32.899122","updated_at":"2026-05-10T10:39:32.899125","current_progress":null,"entries_count":0}},{"id":21,"title":"玩乐关系","original_title":"あそびのかんけい","type":"novel","cover_path":"covers/3e352d1c78c5be39.jpg","cover_thumb_path":"covers/thumbs/3e352d1c78c5be39.webp","description":"誰もが秘密を抱え、あそびのかんけいを続けるラブコメ、スタート！\n\n高校を中退し、ボードゲームカフェ『クルマザ』で店長代理として働く生粋のボドゲオタク常盤孤太郎は、恋をしていた。\nボドゲ愛の欠片もない天敵のような女子高生ギャルバイト小鳥遊みふるに。想いに気付かない当人から進展を煽られるも――\n\n「まずはサイコロを振らなきゃ、恋は始まらないぜ」\n\n告白はありえない。なぜなら……みふるには超絶ラブラブなイケメン彼氏がいるのだから！　\nさらに孤太郎が想いを隠すため、みふるに伝えた嘘の好きな人――女流棋士の歌方月乃は、正体を隠して『クルマザ』に入り浸っている常連客で!?\n誰もが秘密を抱え、あそびのかんけいを続けるラブコメ開幕。","release_status":"ongoing","total_units":4,"total_subunits":null,"unit_label":"本","creators":{"author":"葵せきな"},"created_at":"2026-05-10T06:45:38.526886","updated_at":"2026-05-10T10:34:01.057159","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":11,"name":"校园","color":"#2563eb","created_at":"2026-05-10T06:45:38.521841","work_count":0},{"id":24,"name":"青春","color":"#2563eb","created_at":"2026-05-10T06:45:38.522121","work_count":0}],"collections":[],"main_watching":{"id":21,"work_id":21,"round_number":1,"label":null,"personal_status":"watching","rating":null,"overall_review":null,"started_at":"2026-05-10","finished_at":null,"created_at":"2026-05-09T14:11:59.079660","updated_at":"2026-05-10T07:30:27.877151","current_progress":null,"entries_count":0}},{"id":26,"title":"黄泉使者","original_title":"黄泉のツガイ","type":"anime","cover_path":"covers/9b3c40b766e07db0.jpg","cover_thumb_path":"covers/thumbs/9b3c40b766e07db0.webp","description":"尤尔是一名住在山中小村庄的猎人少年，靠着狩猎野鸟维生，与双胞胎妹妹阿萨及村民们过着朴实的生活。然而，这样平稳的日常却被空中响起的”龙的叫声”给撕裂了──\n安逸的村庄里潜藏着传承与谜团，这个村里究竟藏着什么秘密呢？尤尔的命运又会如何？谜团与不可思议纵横交错的崭新使者战斗──紧张刺激的幻怪奇幻谭，现在揭开序幕。","release_status":"ongoing","total_units":25,"total_subunits":null,"unit_label":null,"creators":{"author":"荒川弘","studio":"BONES"},"created_at":"2026-05-10T06:45:38.527319","updated_at":"2026-05-10T07:20:51.136120","tags":[{"id":4,"name":"奇幻","color":"#2563eb","created_at":"2026-05-10T06:45:38.521619","work_count":0},{"id":7,"name":"战斗","color":"#2563eb","created_at":"2026-05-10T06:45:38.521688","work_count":0}],"collections":[],"main_watching":{"id":26,"work_id":26,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":"2026-05-10","finished_at":null,"created_at":"2026-05-09T14:25:39.540070","updated_at":"2026-05-10T07:21:04.228282","current_progress":null,"entries_count":0}},{"id":28,"title":"油炸绿番茄","original_title":"Fried Green Tomatoes","type":"movie","cover_path":"covers/0e2bb40f286a0e14.jpg","cover_thumb_path":"covers/thumbs/0e2bb40f286a0e14.webp","description":"一次偶然中，失意的艾弗林（凯西·贝茨 Kathy Bates 饰）在养老院里结识了老人妮妮（杰西卡·坦迪 Jessica Tandy 饰），为了开导艾弗林，妮妮为她讲了一个关于女孩爱姬（玛丽·斯图尔特·马斯特森 Mary Stuart Masterson 饰）的故事。\n　　爱姬从小生活在歧视和排挤的环境中，只有哥哥巴迪（克里斯·奥唐纳 Chris O'Donnell 饰）能给她带来短暂的快乐。可是，巴迪在一场车祸中失去了生命，这一巨大的打击让爱姬彻底陷入了自闭之中。这时，善良的露丝（玛丽·露易斯·帕克 Mary-Louise Parker 饰）出现在了爱姬的身边，她的陪伴和爱护让爱姬逐渐走出了阴影，但不久之后，露丝自己却在病痛中去世了。\n　　露丝的死让爱姬感触良多，她开始明白坦然接受生命里的发生的一切，努力帮助他人才是获得幸福的最佳途径。","release_status":"finished","total_units":1,"total_subunits":null,"unit_label":null,"creators":{"director":"乔恩·阿维奈"},"created_at":"2026-05-10T06:45:38.527504","updated_at":"2026-05-10T06:45:38.527505","tags":[],"collections":[],"main_watching":{"id":28,"work_id":28,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:38:01.164464","updated_at":"2026-05-09T14:38:01.164470","current_progress":null,"entries_count":0}},{"id":27,"title":"昭和元禄落语心中","original_title":"昭和元禄落語心中","type":"anime","cover_path":"covers/981d0b1d45097ea8.jpg","cover_thumb_path":"covers/thumbs/981d0b1d45097ea8.webp","description":"无法忘记在刑务所的落语慰问会中见到的大名人·八云的“死神”，出狱的与太郎径直前往寄席。拜倒在八云面前，成为他住所雇工以及弟子的与太郎，却发现在八云之处住着一位名叫小夏的女性。八云与小夏似乎有着他人无从触及的因缘……。","release_status":"finished","total_units":13,"total_subunits":null,"unit_label":null,"creators":{"author":"雲田はるこ","studio":"studiodeen"},"created_at":"2026-05-10T06:45:38.527417","updated_at":"2026-05-10T06:45:38.527418","tags":[{"id":15,"name":"治愈","color":"#2563eb","created_at":"2026-05-10T06:45:38.521935","work_count":0},{"id":17,"name":"历史","color":"#2563eb","created_at":"2026-05-10T06:45:38.521979","work_count":0}],"collections":[],"main_watching":{"id":27,"work_id":27,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:27:40.268745","updated_at":"2026-05-09T14:27:40.268750","current_progress":null,"entries_count":0}},{"id":25,"title":"全部成为F","original_title":"すべてがFになる","type":"novel","cover_path":"covers/bd52f2d17c2db7f8.jpg","cover_thumb_path":"covers/thumbs/bd52f2d17c2db7f8.webp","description":"犀川研究室の旅行で、愛知県にある妃真加島（ひまかじま）[注 1]に向かった犀川創平と研究室の面々。犀川の恩師の娘である西之園萌絵も研究室の正式なメンバーではないが参加していた。妃真加島にはその所有者である真賀田家が設立した『真賀田研究所』があり、実は萌絵は研究所と多少の関わりがあったのだ。\n真賀田研究所には優秀な研究者が集い、（世間の常識からは少し外れているが）彼らなりの論理・生活形態と、それを許容する環境の下で精力的に研究を進めている。その頂点に君臨するのが、真賀田四季博士。彼女は現存する最高の天才で、名実ともに研究所の活動の中心人物であった。彼女は過去に犯した殺人によっても有名人物であり、研究所の一画に隔離されている存在でもあった。\n萌絵の提案で研究所を訪れた犀川と萌絵の前に、不可思議な死体が姿を現す。さらに続いて起こる殺人事件。2人は研究所で起きた事件の謎にとらわれていく。\n作品世界中で1994年の夏に起こった事件。現実の1994年はインターネットやwwwが世間に認知される直前にあたり、コンピュータやネットワークについて知識を持つものは少数であった。\n犀川、萌絵、真賀田四季は、その後の森博嗣作品にも陰に陽に現れる重要なキャラクターである。","release_status":"finished","total_units":1,"total_subunits":null,"unit_label":"本","creators":{"author":"森博嗣"},"created_at":"2026-05-10T06:45:38.527174","updated_at":"2026-05-10T06:45:38.527174","tags":[{"id":29,"name":"悬疑","color":"#2563eb","created_at":"2026-05-10T06:45:38.522215","work_count":0}],"collections":[],"main_watching":{"id":25,"work_id":25,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:23:14.952181","updated_at":"2026-05-09T14:23:14.952187","current_progress":null,"entries_count":0}},{"id":24,"title":"归属的水平线","original_title":"おかえり水平線","type":"manga","cover_path":"covers/d9d98cbe672b55d0.jpg","cover_thumb_path":"covers/thumbs/d9d98cbe672b55d0.webp","description":"海辺の街で、祖父と銭湯を営む遼馬。いつものように学校帰りに開店準備をしていると、父の隠し子を名乗る玲臣という少年がやって来て――？舞台は銭湯。義兄弟が繰り広げる、ビターで温かいヒューマンドラマ開幕！","release_status":"finished","total_units":3,"total_subunits":null,"unit_label":"本","creators":{"author":"渡部大羊"},"created_at":"2026-05-10T06:45:38.527104","updated_at":"2026-05-10T06:45:38.527104","tags":[{"id":9,"name":"日常","color":"#2563eb","created_at":"2026-05-10T06:45:38.521783","work_count":0},{"id":15,"name":"治愈","color":"#2563eb","created_at":"2026-05-10T06:45:38.521935","work_count":0}],"collections":[],"main_watching":{"id":24,"work_id":24,"round_number":1,"label":null,"personal_status":"done","rating":null,"overall_review":null,"started_at":"2026-05-10","finished_at":"2026-05-10","created_at":"2026-05-09T14:19:03.202212","updated_at":"2026-05-10T07:21:20.809062","current_progress":3,"entries_count":2}},{"id":23,"title":"上伊那牡丹，酒醉身姿似百合花般","original_title":"上伊那ぼたん、酔へる姿は百合の花","type":"anime","cover_path":"covers/2b91303177c3bc5a.jpg","cover_thumb_path":"covers/thumbs/2b91303177c3bc5a.webp","description":"上伊那牡丹在升上大学后住进了学生宿舍。\n当她与宿舍成员一同前往秩父参加芝樱祭时，在长椅上看见了独自喝着酒的舍监・砺波伊吹。\n伊吹那副把Highball喝得格外美味的模样吸引了牡丹，让她忍不住心想：「我也想喝喝看。」于是，她人生第一次尝试了喝酒。\n在体会到酒的美味后，牡丹开始和宿舍的伙伴们一起享受烧酒、葡萄酒、威士忌等各式酒类，感情也逐渐加深。\n另一方面，因过去的经历而执着于「一个人喝酒」的伊吹，在与总是开心、看起来喝得很满足的牡丹相处的过程中，也逐渐开始想和她一起喝酒……","release_status":"finished","total_units":12,"total_subunits":null,"unit_label":null,"creators":{"author":"塀"},"created_at":"2026-05-10T06:45:38.527037","updated_at":"2026-05-10T06:45:38.527037","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":13,"name":"轻百合","color":"#2563eb","created_at":"2026-05-10T06:45:38.521895","work_count":0}],"collections":[],"main_watching":{"id":23,"work_id":23,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:16:32.496222","updated_at":"2026-05-09T14:16:32.496227","current_progress":null,"entries_count":0}},{"id":22,"title":"勇者死了！因为勇者掉进了我这个村民挖的陷阱里。","original_title":"勇者が死んだ！村人の俺が掘った落とし穴に勇者が落ちた結果。","type":"manga","cover_path":"covers/63715d0608929f64.jpg","cover_thumb_path":"covers/thumbs/63715d0608929f64.webp","description":"平凡な農夫の少年トウカは、ある日突然、世界の英雄である勇者を殺してしまう！！！しかも、その現場を勇者の仲間である少女に見られていた！！\n　勇者を死なせた男になったトウカの運命は…！！？\n\n　落とし穴からはじまる、村人と美少女たちのちょっとエッチな冒険ファンタジー！！","release_status":"finished","total_units":20,"total_subunits":null,"unit_label":"本","creators":{"author":"スバルイチ"},"created_at":"2026-05-10T06:45:38.526961","updated_at":"2026-05-10T06:45:38.526961","tags":[{"id":6,"name":"搞笑","color":"#2563eb","created_at":"2026-05-10T06:45:38.521667","work_count":0},{"id":20,"name":"卖肉","color":"#2563eb","created_at":"2026-05-10T06:45:38.522035","work_count":0},{"id":28,"name":"冒险","color":"#2563eb","created_at":"2026-05-10T06:45:38.522197","work_count":0}],"collections":[],"main_watching":{"id":22,"work_id":22,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:14:37.659765","updated_at":"2026-05-09T14:14:37.659770","current_progress":null,"entries_count":0}},{"id":20,"title":"山剧","original_title":"山劇","type":"manga","cover_path":"covers/e927d8975f718660.jpg","cover_thumb_path":"covers/thumbs/e927d8975f718660.webp","description":"『少年のアビス』の峰浪りょうが描く、或る山に渦巻く愛憎の物語。\n祖父の山を継ぐと信じて育った高校生・美駒は、幼馴染に初恋の相手を取られ、学校のヒエラルキーからも弾かれていた。\n山だけが、唯一の居場所だった。だがその山に、顔を隠した謎の男が独り小屋を建てていた―…。","release_status":"ongoing","total_units":2,"total_subunits":null,"unit_label":"话","creators":{"author":"峰浪りょう"},"created_at":"2026-05-10T06:45:38.526822","updated_at":"2026-05-10T06:45:38.526823","tags":[],"collections":[],"main_watching":{"id":20,"work_id":20,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:10:40.494979","updated_at":"2026-05-09T14:10:40.494985","current_progress":null,"entries_count":0}},{"id":19,"title":"少年的深渊","original_title":"少年のアビス","type":"manga","cover_path":"covers/8f723a753d7a2af9.jpg","cover_thumb_path":"covers/thumbs/8f723a753d7a2af9.webp","description":"一无所有的城镇，一成不变的生活，身为高中生的黑濑令儿就「只是」活着而已。家族成员、未来梦想、儿时玩伴，上述所有的一切都将他束缚在这座小镇上。如果再这样下去的话，人生就真的「只是」活着而已。这是他心中抱持的想法，直到遇见了那名女子为止——他的生活会出现希望吗？他的未来会邂逅光明吗？彻底反映出「当下」的末日男女邂逅故事就此展开——","release_status":"finished","total_units":18,"total_subunits":null,"unit_label":"本","creators":{"author":"峰浪りょう"},"created_at":"2026-05-10T06:45:38.526734","updated_at":"2026-05-10T06:45:38.526735","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":23,"name":"致郁","color":"#2563eb","created_at":"2026-05-10T06:45:38.522101","work_count":0},{"id":24,"name":"青春","color":"#2563eb","created_at":"2026-05-10T06:45:38.522121","work_count":0},{"id":27,"name":"扭曲","color":"#2563eb","created_at":"2026-05-10T06:45:38.522177","work_count":0}],"collections":[],"main_watching":{"id":19,"work_id":19,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:08:30.125390","updated_at":"2026-05-09T14:08:30.125395","current_progress":null,"entries_count":0}},{"id":18,"title":"我当备胎女友也没关系。","original_title":"わたし、二番目の彼女でいいから。","type":"novel","cover_path":"covers/ea86b52dcb86febb.jpg","cover_thumb_path":"covers/thumbs/ea86b52dcb86febb.webp","description":"我们正作为「备胎」而交往中——这个危险的三角关系的走向是？\n\n「桐岛君也是我第二喜欢的人」\n\n我和早坂同学双方都有自己的本命，却作为备胎交往着。\n即便如此，我和她也是实存的情侣关系。一起回家，偷偷见面，做着对他人不可明说的事。\n但是备胎终究是备胎，如果和最喜欢的本命两情相悦，我们的关系就会解除。当初就这么约好了。\n本该是这样的——","release_status":"finished","total_units":9,"total_subunits":null,"unit_label":"本","creators":{"author":"西条陽"},"created_at":"2026-05-10T06:45:38.526649","updated_at":"2026-05-10T06:45:38.526649","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":8,"name":"后宫","color":"#2563eb","created_at":"2026-05-10T06:45:38.521708","work_count":0},{"id":11,"name":"校园","color":"#2563eb","created_at":"2026-05-10T06:45:38.521841","work_count":0},{"id":16,"name":"党争","color":"#2563eb","created_at":"2026-05-10T06:45:38.521958","work_count":0},{"id":26,"name":"NTR","color":"#2563eb","created_at":"2026-05-10T06:45:38.522157","work_count":0}],"collections":[],"main_watching":{"id":18,"work_id":18,"round_number":1,"label":null,"personal_status":"done","rating":null,"overall_review":null,"started_at":"2026-05-10","finished_at":"2026-05-10","created_at":"2026-05-09T14:05:12.375031","updated_at":"2026-05-10T08:12:37.226522","current_progress":9,"entries_count":2}},{"id":17,"title":"让声称女性之间不可能的女孩，在百日内彻底沦陷的百合故事。","original_title":"女同士とかありえないでしょと言い張る女の子を、百日間で徹底的に落とす百合のお話","type":"novel","cover_path":"covers/cdd756dd728e90b3.jpg","cover_thumb_path":"covers/thumbs/cdd756dd728e90b3.webp","description":"『女同士なんてありえない……はずなのに！』\n\nそれは日常から始まる危険なひと夏の物語。\nモテ系JKの鞠佳は、クラスメイトの絢に突然百万円を突きつけられる。\n「鞠佳の百日間、買うから。女同士がありえないかどうか、試してあげる」\n自分を異性愛者だと思い込んでいる鞠佳は、バリタチ美少女との百日間で身も心も徹底的に落とされてゆく。\nはたして鞠佳は百日目まで『ありえない』と言い張ることができるのか。（できない）\n\n屈服確定！鞠佳の約束された敗北への戦いが、今始まる──。","release_status":"ongoing","total_units":8,"total_subunits":null,"unit_label":"本","creators":{"author":"みかみてれん"},"created_at":"2026-05-10T06:45:38.526562","updated_at":"2026-05-10T06:45:38.526562","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":11,"name":"校园","color":"#2563eb","created_at":"2026-05-10T06:45:38.521841","work_count":0},{"id":14,"name":"百合","color":"#2563eb","created_at":"2026-05-10T06:45:38.521916","work_count":0},{"id":25,"name":"色情","color":"#2563eb","created_at":"2026-05-10T06:45:38.522139","work_count":0}],"collections":[],"main_watching":{"id":17,"work_id":17,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T14:01:02.647389","updated_at":"2026-05-09T14:01:02.647395","current_progress":null,"entries_count":0}},{"id":16,"title":"29岁单身冒险家的日常","original_title":"29歳独身中堅冒険者の日常","type":"anime","cover_path":"covers/61bc9cc8b014aba6.jpg","cover_thumb_path":"covers/thumbs/61bc9cc8b014aba6.webp","description":"这是一个关于笨拙但充满关爱的单身冒险家，遇上了纯真少女的故事──\n\n幼年时期在贫民窟长大，为了活下去而拼命追求强大力量的东云始，如今他作为科迈村的驻村冒险者，过着悠闲自得的日子。\n某天在委托任务中潜入地下城时，他遇见了一名差点被最弱魔物史莱姆吃掉的少女！少女的名字是莉露。为了生存，她独自一人踏入了地下城。阿始实在无法丢下这个被父母抛弃、又无处可去的女孩不管，于是决定把莉露带回村子，两人开始一起生活。\n\n一段笑中带泪、充满温馨的冒险奇幻故事，就此展开！","release_status":"finished","total_units":12,"total_subunits":null,"unit_label":null,"creators":{"author":"奈良一平"},"created_at":"2026-05-10T06:45:38.526451","updated_at":"2026-05-10T06:45:38.526452","tags":[{"id":3,"name":"异世界","color":"#2563eb","created_at":"2026-05-10T06:45:38.521589","work_count":0},{"id":4,"name":"奇幻","color":"#2563eb","created_at":"2026-05-10T06:45:38.521619","work_count":0}],"collections":[],"main_watching":{"id":16,"work_id":16,"round_number":1,"label":null,"personal_status":"done","rating":4.0,"overall_review":"亚撒西世界养女儿物语","started_at":"2026-05-10","finished_at":"2026-05-10","created_at":"2026-05-09T13:59:09.296410","updated_at":"2026-05-09T19:04:53.951422","current_progress":12,"entries_count":2}},{"id":15,"title":"可怜可爱元气君","original_title":"可愛そうにね、元気くん","type":"manga","cover_path":"covers/1f3b70a61d40229e.jpg","cover_thumb_path":"covers/thumbs/1f3b70a61d40229e.webp","description":"看起来没有哪里不对头的保健委员广田君，私下会把同班喜欢的女生画进SM本。\n某天带到学校赶工的原稿不小心落在准备室——","release_status":"finished","total_units":8,"total_subunits":null,"unit_label":"本","creators":{"author":"古宮海"},"created_at":"2026-05-10T06:45:38.526374","updated_at":"2026-05-10T06:45:38.526375","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":11,"name":"校园","color":"#2563eb","created_at":"2026-05-10T06:45:38.521841","work_count":0}],"collections":[],"main_watching":{"id":15,"work_id":15,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:55:54.001820","updated_at":"2026-05-09T13:55:54.001826","current_progress":null,"entries_count":0}},{"id":14,"title":"青春爆走！","original_title":"青春爆走！","type":"manga","cover_path":"covers/694eb068d9dae168.jpg","cover_thumb_path":"covers/thumbs/694eb068d9dae168.webp","description":"日暮まるおは高校デビューに失敗し、ありあまる性欲を持て余す日々。\nそんなある日、まるおをどん底に突き落とす衝撃的事件が…。\n始まってなかった青春がコンプレックスで起動する！","release_status":"ongoing","total_units":6,"total_subunits":null,"unit_label":"本","creators":{"author":"研そうげん"},"created_at":"2026-05-10T06:45:38.526280","updated_at":"2026-05-10T06:45:38.526280","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":11,"name":"校园","color":"#2563eb","created_at":"2026-05-10T06:45:38.521841","work_count":0},{"id":23,"name":"致郁","color":"#2563eb","created_at":"2026-05-10T06:45:38.522101","work_count":0},{"id":24,"name":"青春","color":"#2563eb","created_at":"2026-05-10T06:45:38.522121","work_count":0}],"collections":[],"main_watching":{"id":14,"work_id":14,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:50:12.663686","updated_at":"2026-05-09T13:50:12.663692","current_progress":null,"entries_count":0}},{"id":13,"title":"顺其自然的日子","original_title":"どうにかなる日々","type":"anime","cover_path":"covers/8531d7c37886a46d.jpg","cover_thumb_path":"covers/thumbs/8531d7c37886a46d.webp","description":"誰かを想う日常は、ときに甘くて、ときに痛い。そんな、なるようにしかならない日々も、きっと、いつか。\n元恋人の結婚式、男子校の先生と生徒、心と身体の変化を迎える思春期の幼馴染。誰が相手でも、どんな形でも、全ての恋と生き方には同等の価値がある。\nそして、不器用に誰かを想った日々は、きっといつか愛しい思い出になる。\nそんな“誰かの恋”を優しく見守り、温かく描くオムニバスショートストーリー集。","release_status":"finished","total_units":1,"total_subunits":null,"unit_label":null,"creators":{"author":"志村貴子","studio":"LIDENFILMS"},"created_at":"2026-05-10T06:45:38.526199","updated_at":"2026-05-10T06:45:38.526200","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":9,"name":"日常","color":"#2563eb","created_at":"2026-05-10T06:45:38.521783","work_count":0},{"id":14,"name":"百合","color":"#2563eb","created_at":"2026-05-10T06:45:38.521916","work_count":0}],"collections":[],"main_watching":{"id":13,"work_id":13,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:47:58.261764","updated_at":"2026-05-09T13:47:58.261769","current_progress":null,"entries_count":0}},{"id":12,"title":"冬荫功","original_title":"ต้มยำกุ้ง","type":"movie","cover_path":"covers/b9ab408c1b29964b.jpg","cover_thumb_path":"covers/thumbs/b9ab408c1b29964b.webp","description":"在一个泰国宁静的村落里，纯朴善良的阿锦（托尼·贾）与父亲相依为命，他们过着简单而开心的生活。当年曾担任泰王御兵的父亲闲时还会教授御兵所操练的拳术予阿锦，希望他日练成后可以为国王效力。\n此外，两父子并计划将家中饲养的大象呈献给国王。在泼水节前夕，父亲雀跃地跟村长商量如何将心爱的象呈献给国王，岂料村长另有图谋，与坏人互相勾结，借口把大象送往身体检查，把大象运往澳洲作黑市交易。\n阿锦眼见心爱的伙伴被夺，父亲还被打伤。甘冒生命危险只身远赴澳洲挑战坏人头子玫块夫人，期间遇到泰裔澳洲籍警察马克及被逼当娼妓的巴娜，在他们的协助下，阿锦誓要抢回大象。虽然阿锦遇到不少顽强对手，但凭着勇气及毅力阿锦把他们一一打败。","release_status":"finished","total_units":1,"total_subunits":null,"unit_label":null,"creators":{"director":"柏治也·平寇"},"created_at":"2026-05-10T06:45:38.526115","updated_at":"2026-05-10T06:45:38.526116","tags":[{"id":7,"name":"战斗","color":"#2563eb","created_at":"2026-05-10T06:45:38.521688","work_count":0},{"id":22,"name":"武术","color":"#2563eb","created_at":"2026-05-10T06:45:38.522081","work_count":0}],"collections":[],"main_watching":{"id":12,"work_id":12,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:45:12.952342","updated_at":"2026-05-09T13:45:12.952347","current_progress":null,"entries_count":0}},{"id":11,"title":"天下第一 日本最强武术家决定战","original_title":"テンカイチ 日本最強武芸者決定戦","type":"manga","cover_path":"covers/ed6c736cc834e3dd.jpg","cover_thumb_path":"covers/thumbs/ed6c736cc834e3dd.webp","description":"天下第一日本最强武士选拔赛，激燃最强武士淘汰赛！赌上国家的异种武术战！","release_status":"ongoing","total_units":13,"total_subunits":null,"unit_label":"本","creators":{"author":"あずま京太郎"},"created_at":"2026-05-10T06:45:38.526018","updated_at":"2026-05-10T06:45:38.526019","tags":[{"id":7,"name":"战斗","color":"#2563eb","created_at":"2026-05-10T06:45:38.521688","work_count":0},{"id":21,"name":"热血","color":"#2563eb","created_at":"2026-05-10T06:45:38.522058","work_count":0}],"collections":[],"main_watching":{"id":11,"work_id":11,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:40:29.424804","updated_at":"2026-05-09T13:40:29.424810","current_progress":null,"entries_count":0}},{"id":10,"title":"一拳超人","original_title":"ワンパンマン","type":"manga","cover_path":"covers/c1d26dd3be175344.jpg","cover_thumb_path":"covers/thumbs/c1d26dd3be175344.webp","description":"就職活動に息詰まる主人公サイタマは、一人の少年とその命を狙う怪人カニランテに遭遇する。「ヒーローになりたい」という子供の頃の夢を思い出し、奮起したサイタマは怪人を倒し少年を救う。\n\nそれから三年後、そこには特訓の末に最強の力を手にいれ、頭髪がすべて抜け落ちたサイタマの姿があった。やがて、プロのヒーローとして活動するためにヒーロー協会へ加入。仲間のヒーロー達と共に怪人をはじめとする様々な脅威に立ち向かっていく。","release_status":"ongoing","total_units":36,"total_subunits":null,"unit_label":"本","creators":{"author":"村田雄介"},"created_at":"2026-05-10T06:45:38.525851","updated_at":"2026-05-10T06:45:38.525852","tags":[{"id":4,"name":"奇幻","color":"#2563eb","created_at":"2026-05-10T06:45:38.521619","work_count":0},{"id":6,"nam