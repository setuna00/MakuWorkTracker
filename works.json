tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":6,"name":"搞笑","color":"#2563eb","created_at":"2026-05-10T06:45:38.521667","work_count":0},{"id":11,"name":"校园","color":"#2563eb","created_at":"2026-05-10T06:45:38.521841","work_count":0}],"collections":[],"main_watching":{"id":8,"work_id":8,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:32:58.246262","updated_at":"2026-05-09T13:32:58.246267","current_progress":null,"entries_count":0}},{"id":7,"title":"处女朋克：发条女孩","original_title":"ヴァージン・パンク Clockwork Girl","type":"anime","cover_path":"covers/0029e6adf2cd2f62.jpg","cover_thumb_path":"covers/thumbs/0029e6adf2cd2f62.webp","description":"孤儿院出身的少女神冰羽舞，曾梦想成为索玛迪亚工程师，却在少年时亲眼目睹Mr.优雅处决院长（非法改造索玛迪亚通缉犯），梦想与家园一夕崩毁。对Mr.优雅的恨意，伴随她成长为猎人。十年后，羽舞已是独当一面的赏金猎人，却再度与Mr.优雅相遇。对方试图招募她加入旗下组织「阿基米DEATH」，遭羽舞冷淡拒绝后，枪口指向了她……\n非法改造索玛迪亚通缉犯 VS 赏金猎人——少女的宿命战役由此展开。\n","release_status":"finished","total_units":1,"total_subunits":null,"unit_label":null,"creators":{"author":"梅津泰臣","studio":"SHAFT"},"created_at":"2026-05-10T06:45:38.525567","updated_at":"2026-05-10T06:45:38.525567","tags":[{"id":7,"name":"战斗","color":"#2563eb","created_at":"2026-05-10T06:45:38.521688","work_count":0},{"id":18,"name":"科幻","color":"#2563eb","created_at":"2026-05-10T06:45:38.521997","work_count":0}],"collections":[],"main_watching":{"id":7,"work_id":7,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:30:08.277972","updated_at":"2026-05-09T13:30:08.277978","current_progress":null,"entries_count":0}},{"id":6,"title":"楊花の歌","original_title":"楊花の歌","type":"novel","cover_path":"covers/d2a33bd816842445.jpg","cover_thumb_path":"covers/thumbs/d2a33bd816842445.webp","description":"1941年、日本占領下の福建省廈門。\n大阪松島遊廓から逃走して、上海、広州、香港と渡り歩き、廈門に辿り着いたリリーは、抗日活動家の楊に従い、カフェーで女給として働きながら諜報活動をしていた。あるとき、楊から日本軍諜報員の暗殺を指示され、その実行者として、琥珀色の瞳と蛇の刺青が印象的なヤンファという女性を紹介される。\n中秋節の晩をきっかけに強くヤンファに惹かれていくリリーにとって、彼女と過ごす時間だけが生への実感を持てるひとときになっていた。\nしかし、楊から秘密裏に出されていた指令は、暗殺に失敗した場合はヤンファを殺せというものだった……。\n戦時下の中国・廈門を舞台に流転する女性たちの愛と葛藤を描く、圧巻の熱量を放つ第35回小説すばる新人賞受賞作。","release_status":"finished","total_units":1,"total_subunits":null,"unit_label":"本","creators":{"author":"青波杏"},"created_at":"2026-05-10T06:45:38.525492","updated_at":"2026-05-10T06:45:38.525493","tags":[{"id":14,"name":"百合","color":"#2563eb","created_at":"2026-05-10T06:45:38.521916","work_count":0}],"collections":[],"main_watching":{"id":6,"work_id":6,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:28:31.519698","updated_at":"2026-05-09T13:28:31.519704","current_progress":null,"entries_count":0}},{"id":5,"title":"帝乃三姐妹原来很好搞定。","original_title":"帝乃三姉妹は案外、チョロい。","type":"anime","cover_path":"covers/f57bba6a63207367.jpg","cover_thumb_path":"covers/thumbs/f57bba6a63207367.webp","description":"绫世优是天才女演员的儿子，但无论做什么都低于平均水准。\n母亲去世后，在母亲熟人的介绍下住进了帝乃家。\n与活跃于文艺、武术领域的天才三姐妹住在一起，天才和凡人。\n本以为不好相处的三姐妹，没想到竟然意外地容易相处。","release_status":"finished","total_units":12,"total_subunits":null,"unit_label":null,"creators":{"author":"ひらかわあや","studio":"P.A.WORKS"},"created_at":"2026-05-10T06:45:38.525402","updated_at":"2026-05-10T06:45:38.525402","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":6,"name":"搞笑","color":"#2563eb","created_at":"2026-05-10T06:45:38.521667","work_count":0},{"id":8,"name":"后宫","color":"#2563eb","created_at":"2026-05-10T06:45:38.521708","work_count":0},{"id":16,"name":"党争","color":"#2563eb","created_at":"2026-05-10T06:45:38.521958","work_count":0}],"collections":[],"main_watching":{"id":5,"work_id":5,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:22:55.938520","updated_at":"2026-05-09T13:22:55.938525","current_progress":null,"entries_count":0}},{"id":4,"title":"琉璃的宝石","original_title":"瑠璃の宝石","type":"anime","cover_path":"covers/9836fef4a8ee4218.jpg","cover_thumb_path":"covers/thumbs/9836fef4a8ee4218.webp","description":"最喜欢闪亮亮事物的女高中生──谷川瑠璃，有天听说「可以靠自己采到水晶！」而为了寻找水晶前往山中。她在山里遇见专攻矿物学的女研究生──荒砥凪，于是两人决定一同采集矿物。有时为了寻找水晶走在山中的道路，有时为了捡拾石榴石浸在溪水中，有时又为了寻找未知的矿物而窥望显微镜──瑠璃在凪的引导下，一头栽进了矿物采集的世界。\n「就算是我应该也能采得到才对！」\n这正是任谁都曾有过的梦想。正宗科学冒险故事就要开始了！","release_status":"finished","total_units":13,"total_subunits":null,"unit_label":null,"creators":{"author":"渋谷圭一郎","studio":"StudioBind"},"created_at":"2026-05-10T06:45:38.525309","updated_at":"2026-05-10T06:45:38.525310","tags":[{"id":9,"name":"日常","color":"#2563eb","created_at":"2026-05-10T06:45:38.521783","work_count":0},{"id":13,"name":"轻百合","color":"#2563eb","created_at":"2026-05-10T06:45:38.521895","work_count":0},{"id":15,"name":"治愈","color":"#2563eb","created_at":"2026-05-10T06:45:38.521935","work_count":0}],"collections":[],"main_watching":{"id":4,"work_id":4,"round_number":1,"label":null,"personal_status":"want","rating":null,"overall_review":null,"started_at":null,"finished_at":null,"created_at":"2026-05-09T13:19:23.578916","updated_at":"2026-05-09T13:19:23.578921","current_progress":null,"entries_count":0}},{"id":3,"title":"魔女与使魔","original_title":"ウィッチウォッチ","type":"anime","cover_path":"covers/6bf12596494f0173.jpg","cover_thumb_path":"covers/thumbs/6bf12596494f0173.webp","description":"她的魔法，远远超乎想像。\n拥有鬼之力的高中生·乙木守仁，将成为正在进行魔女修行的儿时玩伴·妮可的使魔，和她一起同居。\n与儿时玩伴久违的重逢使妮可内心充满欣喜，但守仁其实有以使魔身份从预言的灾难中守护妮可的使命在身。\n妮可的魔法引起的无法预测的各种麻烦，年轻男女的两人生活，前途多灾多难又充满不可思议的日子即将开始。","release_status":"finished","total_units":25,"total_subunits":null,"unit_label":null,"creators":{"author":"篠原健太","studio":"BiburyAnimationStudios"},"created_at":"2026-05-10T06:45:38.525202","updated_at":"2026-05-10T06:45:38.525203","tags":[{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":6,"name":"搞笑","color":"#2563eb","created_at":"2026-05-10T06:45:38.521667","work_count":0},{"id":11,"name":"校园","color":"#2563eb","created_at":"2026-05-10T06:45:38.521841","work_count":0},{"id":12,"name":"少女","color":"#2563eb","created_at":"2026-05-10T06:45:38.521870","work_count":0}],"collections":[],"main_watching":{"id":3,"work_id":3,"round_number":1,"label":null,"personal_status":"done","rating":null,"overall_review":null,"started_at":"2026-05-10","finished_at":"2026-05-10","created_at":"2026-05-09T13:13:06.295475","updated_at":"2026-05-10T07:03:07.985613","current_progress":25,"entries_count":2}},{"id":2,"title":"中年男的异世界网购生活","original_title":"アラフォー男の異世界通販","type":"anime","cover_path":"covers/54618fed9f3ab65a.jpg","cover_thumb_path":"covers/thumbs/54618fed9f3ab65a.webp","description":"四十多岁的单身汉健一突然穿越到了异世界。\n他在危机四伏的森林中漫无目的地游荡，意外发现自己可以使用巨型在线购物网站“香格里拉”。\n这是一种“作弊能力”，让他能够用异世界的物品兑换成现代日本的现金！\n健一利用这项能力开始创业，并迅速成为一位颇具名望的商人。\n“我的目标是在这个异世界过上慢生活！”\n他试图在城郊的森林里过上无忧无虑、自给自足的生活，但是……\n才华横溢的健一吸引了众多女孩的目光，他也因此卷入了一连串的麻烦——\n这位四十多岁的男人最终能否实现他梦寐以求的慢生活呢！？\n一段异世界奇幻之旅就此展开！","release_status":"finished","total_units":13,"total_subunits":null,"unit_label":null,"creators":{"author":"朝倉一二三"},"created_at":"2026-05-10T06:45:38.525080","updated_at":"2026-05-10T06:45:38.525082","tags":[{"id":2,"name":"穿越","color":"#2563eb","created_at":"2026-05-10T06:45:38.521547","work_count":0},{"id":3,"name":"异世界","color":"#2563eb","created_at":"2026-05-10T06:45:38.521589","work_count":0},{"id":8,"name":"后宫","color":"#2563eb","created_at":"2026-05-10T06:45:38.521708","work_count":0},{"id":10,"name":"厕纸","color":"#2563eb","created_at":"2026-05-10T06:45:38.521817","work_count":0}],"collections":[],"main_watching":{"id":2,"work_id":2,"round_number":1,"label":null,"personal_status":"done","rating":3.0,"overall_review":"便宜无脑厕纸，总之先逃避，有B就上，一会有贞操不上一会看见胸大又动心的神秘男主。\n你怎么就那么喜欢你那个拖拉机呢？\n","started_at":"2026-05-09","finished_at":"2026-05-09","created_at":"2026-05-09T09:24:26.980023","updated_at":"2026-05-09T14:28:58.635117","current_progress":13,"entries_count":2}},{"id":1,"title":"全修。","original_title":null,"type":"anime","cover_path":"covers/84cd4604fd58ec0c.jpg","cover_thumb_path":"covers/thumbs/84cd4604fd58ec0c.webp","description":"全修，即全部重新画过的意思。\n高中毕业后怀揣着梦想成为动画师的广濑夏子，她的才华得到发挥，并迅速出道为导演。\n首次导演的作品大受欢迎，成为一种社会现象。\n她被世间评价为新锐的天才导演，下一部作品决定是以初恋为主题的恋爱喜剧电影。\n然而，从未喜欢过一个人的夏子不太了解初恋，无法画出分镜，电影制作陷入僵局。\n一天，她在画分镜时突然失去意识，醒来以后发现自己身处小时候热衷的动画电影《走向毁灭的故事》的世界里。","release_status":"finished","total_units":12,"total_subunits":null,"unit_label":null,"creators":{"author":"山﨑みつえ","studio":"MAPPA"},"created_at":"2026-05-10T06:45:38.524765","updated_at":"2026-05-10T06:45:38.524766","tags":[{"id":1,"name":"原创","color":"#2563eb","created_at":"2026-05-10T06:45:38.521401","work_count":0},{"id":3,"name":"异世界","color":"#2563eb","created_at":"2026-05-10T06:45:38.521589","work_count":0},{"id":4,"name":"奇幻","color":"#2563eb","created_at":"2026-05-10T06:45:38.521619","work_count":0},{"id":5,"name":"恋爱","color":"#2563eb","created_at":"2026-05-10T06:45:38.521644","work_count":0},{"id":6,"name":"搞笑","color":"#2563eb","created_at":"2026-05-10T06:45:38.521667","work_count":0},{"id":7,"name":"战斗","color":"#2563eb","created_at":"2026-05-10T06:45:38.521688","work_count":0}],"collections":[],"main_watching":{"id":1,"work_id":1,"round_number":1,"label":null,"personal_status":"done","rating":7.0,"overall_review":"兼用变身卡很经典www\n确实是一般开高走，越往后越浪漫了起来，尤其是第七集结构很好，还有后面渐渐回收的伏笔。\n剧本感觉还是不少细节和打磨问题的，但作为原创至少是一个比较完整的故事，最后的open ending挺浪漫的，也是把所有人都复活了，没留下什么心结。虽然刚开始觉得角色设计一般讨喜，但看下来真当这些九战士牺牲的时候还是比较感人的，destiny安慰小孩那段真的很不错。\n感情上勇者崩坏那段作的很好。(第七集)","started_at":"2026-05-08","finished_at":"2026-05-09","created_at":"2026-05-08T02:51:31.763616","updated_at":"2026-05-09T14:29:12.012164","current_progress":12,"entries_count":5}}]